# Build: docker build -f Dockerfile.vllm -t latentmas-vllm .

# Run: docker run --gpus all -p 8000:8000 -v ~/.cache/huggingface:/root/.cache/huggingface latentmas-vllm

# Run with custom model/devices:
# docker run --gpus all -p 8000:8000 \
#   -v ~/.cache/huggingface:/root/.cache/huggingface \
#   --entrypoint python3 \
#   latentmas-vllm \
#   server.py --use_vllm --model_name Qwen/Qwen2.5-7B-Instruct --vllm_devices 1 --hf_devices cuda:0

# Interactive development mode:
# docker run -it --gpus all -p 8000:8000 \
#   -v ~/.cache/huggingface:/root/.cache/huggingface \
#   -v /home/core/LatentMAS:/app \
#   --name latentmas-dev \
#   --entrypoint /bin/bash \
#   latentmas-vllm

FROM vllm/vllm-openai:latest

WORKDIR /app

# Install additional dependencies (vLLM image already has torch, transformers, etc.)
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn pydantic matplotlib
RUN pip install flash-attn --no-build-isolation

# Copy application code
COPY *.py ./
COPY methods/ ./methods/
COPY data/ ./data/

# Expose the API port
EXPOSE 8000

# Default command - runs LatentMAS server with vLLM enabled
# Override model_name and devices as needed
CMD ["python3", "server.py", "--use_vllm", "--model_name", "Qwen/Qwen3-8B", "--vllm_devices", "1", "--hf_devices", "cuda:0"]
